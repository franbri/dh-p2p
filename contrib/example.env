# Copy to /etc/dh-p2p/<name>.env (chmod 600), one file per camera / NVR

# Serial number of the device
SERIAL=YOUR_SERIAL

# [bind_address:]port:remote_port
# 0.0.0.0 lets other machines on the network connect, use a different
# local port per device when running several tunnels
PORT=0.0.0.0:554:554

# Only for devices that answer 403 when the P2P channel is created
#DH_USERNAME=admin
#DH_PASSWORD=secret

# Extra options, e.g. --relay, --no-relay, --punch-timeout 15, --verbose
EXTRA_ARGS=

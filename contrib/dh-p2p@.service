# One tunnel per camera: settings live in /etc/dh-p2p/<name>.env
#   systemctl enable --now dh-p2p@<name>
[Unit]
Description=Dahua P2P tunnel (%i)
Documentation=https://github.com/franbri/dh-p2p
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/dh-p2p/%i.env
ExecStart=/usr/local/bin/dh-p2p --port ${PORT} $EXTRA_ARGS ${SERIAL}
# dh-p2p reconnects by itself, this only covers fatal errors and crashes
Restart=always
RestartSec=30

# Unprivileged throwaway user, only allowed to bind ports below 1024
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
